rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true;
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if isAdmin();
      allow update: if isAdmin()
        && (request.auth.uid != userId
          || (request.resource.data.role == resource.data.role
            && request.resource.data.isActive == resource.data.isActive));
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if isAdmin() || resource.data.isApproved == true;
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.isApproved == false
          && request.resource.data.keys().hasOnly(['clientName', 'rating', 'reviewText', 'photoUrl', 'userId', 'isApproved', 'createdAt'])
          && request.resource.data.clientName is string
          && request.resource.data.clientName.size() > 0
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.reviewText is string
          && request.resource.data.reviewText.size() > 0
          && request.resource.data.photoUrl is string
          && request.resource.data.createdAt == request.time);
      allow update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && hasOnly(['userId', 'customerName', 'phone', 'serviceSelected', 'serviceId', 'preferredDate', 'preferredTime', 'notes', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.serviceSelected is string
        && request.resource.data.serviceSelected.size() > 0
        && request.resource.data.serviceSelected.size() <= 160
        && request.resource.data.serviceId is string
        && request.resource.data.serviceId.size() > 0
        && exists(/databases/$(database)/documents/services/$(request.resource.data.serviceId))
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.isActive == true
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.size() > 0
        && request.resource.data.preferredTime is string
        && request.resource.data.preferredTime.size() > 0
        && request.resource.data.notes is string;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && resource.data.status in ['Pending', 'Confirmed']
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /enquiries/{enquiryId} {
      allow create: if hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.status == 'NEW'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'client'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'createdAt', 'updatedAt']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId == 'salon' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && hasOnly(['adminId', 'action', 'module', 'recordId', 'description', 'createdAt'])
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
